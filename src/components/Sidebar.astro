---
import logo from "../assets/logo.png";
---

<aside class="sidebar">
  <img class="logo" src={logo.src} alt="Low Level Wiki" />
  <nav>
    <ul class="navbar-list">
      <li><a href="https://discord.gg/v9cjaBsnzJ">Discord</a></li>
      <li><a href="https://github.com/lowlevelwiki">GitHub</a></li>
    </ul>
  </nav>
</aside>

<style>
  .sidebar {
    width: 100%;
    max-width: 200px;
    border-right: 1px solid;
    background-color: #bac2de;

    nav .navbar-list {
      list-style: none;
      margin: 0;
      padding: 24px;
      li {
        padding: 6px 0;
        margin: 0;
      }
      font-size: 1em;
    }
  }

  .logo {
    width: 9em;
    display: block;
    margin: 24px auto auto;
    box-shadow: 0px 0px 10px;
  }
</style>
